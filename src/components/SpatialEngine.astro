---
/**
 * THE BOMBING OF DARWIN — HISTORICAL SPATIAL ENGINE
 * Spatial Engine Stage Component
 * 
 * Provides the persistent CesiumJS geographic viewport, 
 * museum-grade institutional orientation overlays, and the static WebGL fallback.
 * Manual demonstration state buttons are restricted to development mode only.
 */

import { DEMONSTRATION_STATES, ORDERED_DEMO_STATE_IDS } from '../lib/spatial/spatial-config';
import { CANONICAL_EVIDENCE_RECORDS } from '../lib/spatial/spatial-evidence-overlay';

interface Props {
  className?: string;
  initialStateId?: string;
}

const { className = '', initialStateId = 'STATE_00_WORLD' } = Astro.props;
const statesList = ORDERED_DEMO_STATE_IDS.map(id => DEMONSTRATION_STATES[id]);
const evidenceList = Object.values(CANONICAL_EVIDENCE_RECORDS);
const isDev = import.meta.env.DEV;
---

<div class={`spatial-stage ${className}`} data-spatial-stage id="spatial-engine-root">
  <!-- Spatial Canvas Container for Cesium -->
  <div class="spatial-stage__canvas" data-cesium-container id="cesium-container" aria-label="Geographic spatial view of Australia and Darwin Harbour" role="region">
  </div>

  <!-- Accessible Static / WebGL Failure Fallback -->
  <div class="spatial-fallback" data-spatial-fallback aria-hidden="true">
    <div class="spatial-fallback__inner">
      <div class="spatial-fallback__header">
        <span class="spatial-fallback__tag">GEOGRAPHIC STAGE · CONTEMPORARY GEOGRAPHY</span>
        <span class="spatial-fallback__coord">12°28'21"S · 130°50'55"E</span>
      </div>
      <div class="spatial-fallback__visual">
        <svg viewBox="0 0 400 300" class="spatial-fallback__map" aria-label="Stylized dark map of Darwin Harbour and Stokes Hill Wharf">
          <rect width="100%" height="100%" fill="#07090B" />
          <!-- Continental / Harbour contours -->
          <path d="M 40,80 Q 140,50 200,90 T 320,120 T 380,240 L 400,300 L 0,300 Z" fill="#111418" stroke="#1B2025" stroke-width="1.5" />
          <path d="M 120,140 Q 180,120 220,160 T 300,220" fill="none" stroke="#252B32" stroke-dasharray="3 3" />
          <!-- Stokes Hill Wharf Marker (Contemporary) -->
          <circle cx="218" cy="164" r="5" fill="#C6A15B" />
          <circle cx="218" cy="164" r="14" fill="none" stroke="#C6A15B" stroke-width="1" opacity="0.4" />
          <text x="232" y="168" fill="#EEE9DF" font-family="monospace" font-size="10" letter-spacing="1">STOKES HILL WHARF</text>
        </svg>
      </div>
      <p class="spatial-fallback__desc">
        Hardware-accelerated 3D is inactive. Displaying geographic orientation coordinates for Stokes Hill Wharf, Darwin Harbour (contemporary survey).
      </p>
    </div>
  </div>

  <!-- Restrained Institutional Spatial Header (Visitor Facing) -->
  <header class="spatial-stage__hud" aria-label="Geographic Orientation">
    <div class="spatial-stage__hud-top">
      <div class="spatial-stage__title-group">
        <span class="spatial-stage__eyebrow">HISTORICAL SPATIAL ENGINE</span>
        <span class="spatial-stage__status-dot" data-spatial-live-dot aria-hidden="true"></span>
      </div>
      <div class="spatial-stage__meta" data-spatial-meta>
        <span class="spatial-stage__class" data-spatial-class>CONTEMPORARY GEOGRAPHY · VERIFIED</span>
      </div>
    </div>

    {isDev && (
      <nav class="spatial-stage__dev-states" aria-label="Development Manual State Switcher">
        <span class="spatial-stage__dev-badge">[DEV]</span>
        {statesList.map((st) => (
          <button 
            type="button" 
            class="spatial-state-btn" 
            data-state-id={st.id}
            data-state-code={st.code}
            aria-pressed={st.id === initialStateId ? "true" : "false"}
            title={`[DEV ONLY] Jump camera to: ${st.label}`}
          >
            <span class="spatial-state-btn__code">{st.code}</span>
            <span class="spatial-state-btn__label">{st.label}</span>
          </button>
        ))}
      </nav>
    )}
  </header>

  <!-- Semantic DOM Equivalent for Spatial Evidence Entities (Keyboard & Screen Reader Access) -->
  <aside class="spatial-stage__evidence-access" aria-label="Interactive Historical Evidence Points">
    <div class="spatial-stage__evidence-header">
      <span class="spatial-stage__evidence-tag record">EVIDENCE ROSTER</span>
      <span class="spatial-stage__evidence-hint sr-only">Keyboard and screen-reader access to historical evidence points</span>
    </div>
    <ul class="spatial-stage__evidence-list" role="list">
      {evidenceList.map((item) => (
        <li>
          <button
            type="button"
            class="spatial-evidence-chip"
            data-evidence-id={item.id}
            aria-haspopup="dialog"
            aria-label={`Inspect historical evidence: ${item.title}, ${item.time || ''}. Classification: ${(item.classification || 'ESTABLISHED_FACT').replace(/_/g, ' ')}`}
          >
            <span class="spatial-evidence-chip__time record">{item.time}</span>
            <span class="spatial-evidence-chip__title">{item.title}</span>
            <span class="spatial-evidence-chip__badge record">{item.badge}</span>
          </button>
        </li>
      ))}
    </ul>
  </aside>

  <!-- Restrained footer metadata & compliant attribution -->
  <footer class="spatial-stage__foot" aria-label="Spatial Engine Metadata and Attribution">
    <span class="spatial-stage__scope" data-spatial-scope>AUSTRALIA & INDO-PACIFIC</span>
    <div class="spatial-stage__credits" data-spatial-credits id="spatial-credits">
      <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">© OpenStreetMap</a> · <a href="https://carto.com/attributions" target="_blank" rel="noopener">© CARTO</a> · GEOSCIENCE AUSTRALIA
    </div>
  </footer>
</div>

<style>
  .spatial-stage {
    position: relative;
    width: 100%;
    height: 100%;
    background: #07090B;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .spatial-stage__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    background: #07090B;
    pointer-events: none;
  }

  /* Remove default Cesium canvas focus ring / border */
  .spatial-stage__canvas :global(canvas) {
    outline: none !important;
  }

  /* WebGL Fallback */
  .spatial-fallback {
    display: none;
    position: absolute;
    inset: 0;
    z-index: 2;
    background: #07090B;
    padding: 24px;
    align-items: center;
    justify-content: center;
  }

  .spatial-fallback.is-active {
    display: flex;
  }

  .spatial-fallback__inner {
    max-width: 360px;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 14px;
    border: 1px solid rgba(236, 231, 219, 0.12);
    padding: 20px;
    background: rgba(17, 20, 24, 0.92);
  }

  .spatial-fallback__header {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono, monospace);
    font-size: 0.65rem;
    color: var(--bone-mute, #949a9e);
    letter-spacing: 0.08em;
  }

  .spatial-fallback__visual {
    width: 100%;
    aspect-ratio: 4 / 3;
    border: 1px solid rgba(236, 231, 219, 0.06);
    overflow: hidden;
  }

  .spatial-fallback__desc {
    font-family: var(--font-mono, monospace);
    font-size: 0.72rem;
    color: var(--bone-dim, #d7d0c4);
    line-height: 1.5;
    margin: 0;
  }

  /* Restrained Institutional HUD Header */
  .spatial-stage__hud {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 10;
    padding: 12px 14px;
    background: linear-gradient(180deg, rgba(7, 9, 11, 0.92) 0%, rgba(7, 9, 11, 0.5) 75%, transparent 100%);
    pointer-events: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .spatial-stage__hud-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .spatial-stage__title-group {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .spatial-stage__eyebrow {
    font-family: var(--font-mono, monospace);
    font-size: 0.65rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--bone, #eee9df);
    opacity: 0.85;
  }

  .spatial-stage__status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--gold, #c6a15b);
    box-shadow: 0 0 8px rgba(198, 161, 91, 0.8);
  }

  .spatial-stage__meta {
    font-family: var(--font-mono, monospace);
    font-size: 0.60rem;
    letter-spacing: 0.10em;
    color: var(--bone-mute, #949a9e);
  }

  /* Dev-only controls */
  .spatial-stage__dev-states {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: 6px;
    overflow-x: auto;
    scrollbar-width: none;
    padding-top: 4px;
  }

  .spatial-stage__dev-badge {
    font-family: var(--font-mono, monospace);
    font-size: 0.55rem;
    color: #c6a15b;
    border: 1px solid rgba(198, 161, 91, 0.3);
    padding: 2px 4px;
    border-radius: 2px;
  }

  .spatial-state-btn {
    appearance: none;
    background: rgba(17, 20, 24, 0.75);
    border: 1px solid rgba(236, 231, 219, 0.12);
    color: var(--bone-dim, #d7d0c4);
    padding: 4px 8px;
    font-family: var(--font-mono, monospace);
    font-size: 0.60rem;
    letter-spacing: 0.05em;
    display: flex;
    align-items: center;
    gap: 5px;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  .spatial-state-btn:hover {
    background: rgba(27, 32, 37, 0.9);
    border-color: rgba(198, 161, 91, 0.4);
    color: var(--bone, #eee9df);
  }

  .spatial-state-btn[aria-pressed="true"] {
    background: rgba(198, 161, 91, 0.15);
    border-color: var(--gold, #c6a15b);
    color: var(--gold-bright, #e8c784);
  }

  .spatial-state-btn__code {
    opacity: 0.65;
    font-size: 0.55rem;
  }

  /* Footer */
  .spatial-stage__foot {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 10;
    padding: 8px 14px;
    background: linear-gradient(0deg, rgba(7, 9, 11, 0.92) 0%, transparent 100%);
    pointer-events: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-mono, monospace);
    font-size: 0.58rem;
    color: var(--bone-mute, #949a9e);
    letter-spacing: 0.08em;
  }

  .spatial-stage__credits {
    opacity: 0.85;
    pointer-events: auto;
  }

  .spatial-stage__credits a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px dotted rgba(148, 154, 158, 0.4);
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .spatial-stage__credits a:hover {
    color: var(--bone, #eee9df);
    border-bottom-color: var(--bone, #eee9df);
  }

  /* Accessible Evidence Roster (DOM equivalent for Cesium entities) */
  .spatial-stage__evidence-access {
    position: absolute;
    bottom: 30px;
    left: 0;
    right: 0;
    z-index: 10;
    padding: 6px 14px;
    background: rgba(7, 9, 11, 0.88);
    backdrop-filter: blur(6px);
    border-top: 1px solid rgba(236, 231, 219, 0.08);
    display: flex;
    align-items: center;
    gap: 12px;
    overflow-x: auto;
  }

  .spatial-stage__evidence-header {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .spatial-stage__evidence-tag {
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    color: var(--gold, #c6a15b);
    font-weight: 500;
  }

  .spatial-stage__evidence-list {
    display: flex;
    gap: 6px;
    list-style: none;
    padding: 0;
    margin: 0;
    align-items: center;
    flex-wrap: nowrap;
  }

  .spatial-evidence-chip {
    background: rgba(18, 22, 27, 0.9);
    border: 1px solid rgba(236, 231, 219, 0.14);
    border-radius: 2px;
    color: var(--bone, #eee9df);
    padding: 4px 8px;
    font-family: var(--font-mono, monospace);
    font-size: 0.65rem;
    letter-spacing: 0.03em;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  .spatial-evidence-chip:hover {
    background: rgba(27, 32, 37, 0.95);
    border-color: rgba(198, 161, 91, 0.5);
    color: #fff;
  }

  .spatial-evidence-chip:focus-visible {
    outline: 2px solid var(--gold, #c6a15b);
    outline-offset: 1px;
  }

  .spatial-evidence-chip__time {
    color: var(--gold, #c6a15b);
    font-weight: 500;
    font-size: 0.60rem;
  }

  .spatial-evidence-chip__title {
    color: var(--bone, #eee9df);
  }

  .spatial-evidence-chip__badge {
    font-size: 0.55rem;
    color: var(--bone-mute, #949a9e);
    border-left: 1px solid rgba(236, 231, 219, 0.15);
    padding-left: 6px;
  }
</style>

<script>
  import { CANONICAL_EVIDENCE_RECORDS } from '../lib/spatial/spatial-evidence-overlay';

  document.querySelectorAll<HTMLButtonElement>('[data-evidence-id]').forEach(btn => {
    btn.addEventListener('click', () => {
      const id = btn.getAttribute('data-evidence-id');
      if (id && CANONICAL_EVIDENCE_RECORDS[id]) {
        if (typeof window !== 'undefined' && (window as any).openEvidenceLedger) {
          (window as any).openEvidenceLedger(CANONICAL_EVIDENCE_RECORDS[id]);
        }
      }
    });
  });
</script>
